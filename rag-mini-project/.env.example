# Copy to .env and edit. Placeholders only - never commit real keys.
RAG_KB_DIR=data/knowledge_base
RAG_INDEX_DIR=artifacts/index
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_EMBEDDER=lsa                 # lsa | tfidf | sentence-transformers
RAG_LSA_DIMS=128
RAG_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
RAG_MIN_COVERAGE=0.34
RAG_MAX_CONTEXT_CHARS=6000
RAG_LLM_PROVIDER=extractive      # extractive | anthropic | ollama
RAG_ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=your-api-key-here
RAG_OLLAMA_MODEL=llama3.1
RAG_OLLAMA_URL=http://localhost:11434
